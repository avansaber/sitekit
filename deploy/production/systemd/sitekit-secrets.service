[Unit]
Description=Load SiteKit production secrets before Docker starts
Wants=network-online.target
After=network-online.target
Before=docker.service
RequiresMountsFor=@DATA_DIR@

[Service]
Type=oneshot
Environment=SITEKIT_HOST_CONFIG=@HOST_CONFIG@
WorkingDirectory=@PROJECT_DIR@
ExecStart=/usr/bin/bash @PROJECT_DIR@/deploy/production/sitekit.sh secrets
RemainAfterExit=yes